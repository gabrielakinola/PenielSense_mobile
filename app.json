{
  "expo": {
    "name": "Peniel Care",
    "slug": "peniel-care",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "penielcare",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.peniel.penielcare"
    },
    "android": {
      "package": "com.peniel.penielcare",
      "adaptiveIcon": {
        "backgroundColor": "#070B14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/peniel_logo_p.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#070B14"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "96742f5d-8ab1-4574-b264-7e91f057795b"
      }
    },
    "owner": "temmygs-team"
  }
}
