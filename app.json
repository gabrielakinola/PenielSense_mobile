{
  "expo": {
    "name": "Penielsense",
    "slug": "penielsense",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "penielsense",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uk.co.penielsense.app"
    },
    "android": {
      "package": "uk.co.penielsense.app",
      "adaptiveIcon": {
        "backgroundColor": "#070B14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/peniel_logo_p.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#070B14"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "294e922a-ec23-4080-8fd7-d39dc801381b"
      }
    },
    "owner": "temmygs-team"
  }
}
